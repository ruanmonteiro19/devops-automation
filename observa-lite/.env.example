# Generate real credentials using ./scripts/docker-init.sh (never commit your .env).
OBSERVA_ADMIN_TOKEN=CHANGE_TO_RANDOM_64_CHARACTER_HEX_SECRET
OBSERVA_AGENT_TOKEN=CHANGE_TO_ANOTHER_RANDOM_64_CHARACTER_HEX_SECRET
OBSERVA_BIND_ADDR=127.0.0.1
OBSERVA_PORT=8080
OBSERVA_AGENT_INTERVAL=30s
OBSERVA_ALLOW_PRIVATE_TARGETS=false
OBSERVA_LOKI_PORT=3100
# Optional when pulling from GHCR instead of building locally:
# OBSERVA_SERVER_IMAGE=ghcr.io/ruanmonteiro19/observa-lite-server:edge
# OBSERVA_AGENT_IMAGE=ghcr.io/ruanmonteiro19/observa-lite-agent:edge
